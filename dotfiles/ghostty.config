# My Ghostty config. Goes in ~/.config/ghostty/config.
# Reload with Cmd+Shift+, or restart Ghostty.

theme = Catppuccin Mocha

background = #0b0b0f
background-opacity = 0.90

font-family = "JetBrains Mono Nerd Font"
font-size = 14
bold-is-bright = true

# Window
window-padding-x = 3
window-padding-y = 3
macos-titlebar-style = native

# Cursor
cursor-style = block

