# ─────────────────────────────────────────────────────────────────────
#  Ghostty terminal config
#  Path: ~/.config/ghostty/config
#  Reload with: Cmd+Shift+,  (or restart Ghostty)
# ─────────────────────────────────────────────────────────────────────

theme = Catppuccin Mocha

# Near-black background, slightly translucent
background = #0b0b0f
background-opacity = 0.90

# Nerd Font — required for Starship / eza icons
font-family = "JetBrains Mono Nerd Font"
font-size = 14
bold-is-bright = true

# Window
window-padding-x = 3
window-padding-y = 3
macos-titlebar-style = native

# Cursor
cursor-style = block

# ─── Optional extras ─────────────────────────────────────────────────
# Hide the title bar entirely (macOS):
# macos-titlebar-style = hidden

# Blur behind the window (macOS):
# background-blur = 20

# Open new tabs in the same working directory:
# window-new-tab-position = current

# Unlimited scrollback (costs RAM; 10k is plenty):
# scrollback-limit = 10000

# Copy on select:
# copy-on-select = clipboard
