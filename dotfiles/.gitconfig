# ─────────────────────────────────────────────────────────────────────
#  .gitconfig — sane defaults for hackathon speed
#  Copy to ~/.gitconfig, then change name + email.
# ─────────────────────────────────────────────────────────────────────

[user]
	# TODO: change these to yours
	name = Your Name
	email = you@example.com

[init]
	defaultBranch = main

[fetch]
	prune = true

[pull]
	# rebase keeps history linear and avoids noisy merge commits
	ff = only
	rebase = true

[push]
	# no more `--set-upstream` on every new branch
	autoSetupRemote = true

[rebase]
	autosquash = true
	autostash = true

[merge]
	# shows the common ancestor in conflicts — much easier to resolve
	conflictstyle = zdiff3

[core]
	editor = code --wait
	pager = delta
	# stop .DS_Store / Thumbs.db from ever being committed
	excludesFile = ~/.config/git/ignore

[interactive]
	diffFilter = delta --color-only

[diff]
	colorMoved = default

[delta]
	navigate = true
	line-numbers = true
	syntax-theme = Catppuccin Mocha
	hunk-header-style = file line-number syntax

[column]
	ui = auto

[color]
	ui = auto

# ─── Shortcuts ───────────────────────────────────────────────────────
[alias]
	st = status -sb
	co = checkout
	br = branch
	lg = log --oneline --graph --decorate -30
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	wip = commit -am "wip"
	# what am I about to push?
	outgoing = log --oneline @{u}..HEAD
